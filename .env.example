# ──────────────────────────────────────────────────────────────
# ChemLab API — environment variables (template)
# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored and must never be committed.
# ──────────────────────────────────────────────────────────────

# Host port published by Docker Compose. The container always
# listens on 8030 internally; this only changes the port exposed
# on your machine. Read by Compose, ignored by the app.
API_PORT=8030

# Application settings (pydantic-settings). All optional — these
# are the built-in defaults, shown here for reference. Uncomment
# to override.
# API_TITLE=ChemLab API
# API_DESCRIPTION=Open-source REST API powering ChemLab, a virtual chemistry laboratory for Spanish Secondary Education students
